[Unit]
# ME3 voice agent (the "brain"). Runs ~/me3/agent.py.
#
# It needs:
#   - the EMEET M1A USB mic plugged in (exits cleanly with "NO MICROPHONE FOUND"
#     otherwise — systemd will keep retrying per Restart=).
#   - VPN up for remote voice (DGX3 Qwen2-Audio ASR / Qwen3-TTS). ME3_VOICE=local
#     falls back to local whisper.cpp + Piper if the VPN is down.
Description=ME3 voice agent (pipecat; ASR/LLM/TTS, drives the Boots UI on :8330)
After=network-online.target me2-ui.service openvpn-sharc.service
Wants=network-online.target me2-ui.service

[Service]
# Environment= MUST live in [Service] (2026-11-07): these lines used to sit in
# [Unit], where systemd ignores them ("Unknown key 'Environment' in section
# [Unit]") — so none of them ever applied.
# ME3_VOICE: remote (default, DGX3 over VPN) or local (whisper.cpp + Piper).
Environment=ME3_VOICE=remote
Environment=ME3_NOISE_FLOOR_RMS=0.006
# Mic gate while Boots speaks: 0 = mic stays OPEN (barge-in), relying on the
# EMEET M1A's on-board full-duplex echo cancellation (measured 2026-11-07).
# Set to 1 to restore the old "mute mic during TTS" behaviour (no code change),
# then: sudo systemctl daemon-reload && sudo systemctl restart me3-agent
Environment=ME3_GATE_MIC=0
# 2026-11-07: Deepgram Nova-3 streaming ASR. Voice stays edge-tts Roger: Deepgram's
# Aura voice (ME3_TTS=deepgram) streamed slower than real time from this network
# (choppy), while Microsoft's nearby servers keep up.
Environment=ME3_STT=deepgram
Environment=ME3_SMART_TURN=0
Type=simple
User=jan
WorkingDirectory=/home/jan/me3
ExecStart=/home/jan/me3/.venv/bin/python /home/jan/me3/agent.py
Restart=always
RestartSec=8
StandardOutput=append:/home/jan/me3/agent.log
StandardError=append:/home/jan/me3/agent.log

[Install]
WantedBy=multi-user.target
